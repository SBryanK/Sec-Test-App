{
  "name": "@teo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "credits:topup": "tsx src/db/topup.ts",
    "build": "node ../../ops/build-api.mjs",
    "start:dev": "tsx src/index.ts",
    "db:migrate:prod": "node dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@teo/shared": "*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10"
  }
}
