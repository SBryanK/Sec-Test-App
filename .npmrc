# Expo / React Native pull in a wide peer range; npm's strict resolver fights it.
legacy-peer-deps=true
audit=false
fund=false

# NOTE: no cache/logs paths here on purpose. Hardcoding them would break every
# other machine. If you need to relocate npm's cache (a sandbox where $HOME is
# not writable, for example), set TEO_NPM_CACHE in .env.local — env.sh wires it
# into npm_config_cache.
